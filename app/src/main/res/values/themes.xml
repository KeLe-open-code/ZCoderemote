<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZRemote" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/zr_primary</item>
        <item name="colorOnPrimary">@color/zr_on_primary</item>
        <item name="colorSurface">@color/zr_surface</item>
        <item name="colorSurfaceContainer">@color/zr_surface</item>
        <item name="colorOnSurface">@color/zr_text</item>
        <item name="colorOnSurfaceVariant">@color/zr_text_dim</item>
        <item name="colorOutline">@color/zr_outline</item>
        <item name="android:colorBackground">@color/zr_bg</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.ZRemote.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/zr_primary</item>
        <item name="android:textColor">@color/zr_on_primary</item>
    </style>

    <style name="Widget.ZRemote.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/zr_outline</item>
        <item name="android:textColor">@color/zr_text</item>
    </style>
</resources>
